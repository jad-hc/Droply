generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  RESTAURANT_OWNER
  RESTAURANT_STAFF
  DRIVER
  ADMIN
}

enum RestaurantMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum DriverStatus {
  OFFLINE
  AVAILABLE
  BUSY
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  phone    String? @unique
  password String
  image    String?

  roles UserRole[] @default([CUSTOMER])

  addresses             Address[]
  ownedRestaurants      Restaurant[]       @relation("RestaurantOwner")
  restaurantMemberships RestaurantMember[]
  driverProfile         DriverProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id String @id @default(cuid())

  label        String?
  addressLine  String
  city         String
  area         String?
  building     String?
  floor        String?
  apartment    String?
  instructions String?

  latitude  Float?
  longitude Float?

  isDefault Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Restaurant {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String?
  phone       String?
  email       String?
  logo        String?
  coverImage  String?

  isActive   Boolean @default(true)
  isApproved Boolean @default(false)

  address   String?
  city      String?
  area      String?
  latitude  Float?
  longitude Float?

  ownerId String
  owner   User   @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  members RestaurantMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([city])
}

model RestaurantMember {
  id String @id @default(cuid())

  role RestaurantMemberRole @default(STAFF)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, restaurantId])
  @@index([restaurantId])
}

model DriverProfile {
  id String @id @default(cuid())

  status DriverStatus @default(OFFLINE)

  vehicleType   String?
  vehicleModel  String?
  vehiclePlate  String?
  licenseNumber String?

  currentLatitude  Float?
  currentLongitude Float?

  isApproved Boolean @default(false)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
